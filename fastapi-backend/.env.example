# ==============================================================================
# PayPruf FastAPI Backend Environment Configuration
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=True

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / SQLite)
# ------------------------------------------------------------------------------
# Option A: Local PostgreSQL Database
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/paypruf

# Option B: Supabase Cloud PostgreSQL Database
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or using Supabase Connection Pooler (Port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option C: Zero-Config Local SQLite Fallback (Default)
DATABASE_URL=sqlite:///./data/paypruf.db

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Run `openssl rand -hex 32` to generate a secure secret key
JWT_SECRET=paypruf_secure_jwt_secret_key_2026_super_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. AI & VISION OCR (Google Gemini)
# ------------------------------------------------------------------------------
# Required for primary Gemini Vision OCR receipt reading
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 4. SUPABASE CLIENT (Optional - for Supabase Auth / Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads/receipts
MAX_UPLOAD_SIZE_BYTES=8388608
